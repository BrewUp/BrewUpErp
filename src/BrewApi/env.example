BrewUp__Embeddings__DeploymentName=text-embedding-3-small
BrewUp__Embeddings__Dimensions=1536
BrewUp__Embeddings__ApiKey=
BrewUp__Embeddings__TenantId=
BrewUp__Embeddings__UseManagedIdentity=false

############################################################
# Mother
############################################################

BrewUp__Mother__A2A__Enabled=true
BrewUp__Mother__A2A__KnowledgeAgentUrl=http://localhost:8080

############################################################
# Knowledge Agent
############################################################

KnowledgeAgent__Mcp__ServerName=knowledge
