############################################################
# MongoDB
############################################################

BrewUp__MongoDbSettings__ConnectionString=
BrewUp__MongoDbSettings__DatabaseName=BrewUp

############################################################
# EventStore
############################################################

BrewUp__EventStore__ConnectionString=

############################################################
# RabbitMQ
############################################################

BrewUp__RabbitMQ__Host=localhost
BrewUp__RabbitMQ__ExchangeCommandName=
BrewUp__RabbitMQ__ExchangeEventName=
BrewUp__RabbitMQ__Username=guest
BrewUp__RabbitMQ__Password=guest
BrewUp__RabbitMQ__ClientId=BrewUp
BrewUp__RabbitMQ__UseRMQ=false

############################################################
# Azure Service Bus
############################################################

BrewUp__AzureServiceBus__ConnectionString=
BrewUp__AzureServiceBus__TopicName=
BrewUp__AzureServiceBus__ClientId=
BrewUp__AzureServiceBus__MaxConcurrentCalls=1
BrewUp__AzureServiceBus__UseAzureServiceBus=true

############################################################
# SQL Server
############################################################

BrewUp__SqlServer__ConnectionString=Server=
BrewUp__SqlServer__SnapshotSize=1000
BrewUp__SqlServer__Dimensions=1536

############################################################
# MCP Servers
############################################################

BrewUp__McpServers__MotherUrl=http://localhost:8090/mcp
BrewUp__McpServers__SalesUrl=http://localhost:8084/mcp
BrewUp__McpServers__WarehouseUrl=http://localhost:8083/mcp
BrewUp__McpServers__MasterDataUrl=http://localhost:8082/mcp
BrewUp__McpServers__KnowledgeUrl=http://localhost:8081/mcp

############################################################
# Azure OpenAI (Chat)
############################################################

BrewUp__AzureOpenAI__Endpoint=
BrewUp__AzureOpenAI__DeploymentName=mistral-small-2503
BrewUp__AzureOpenAI__ApiKey=
BrewUp__AzureOpenAI__TenantId=
BrewUp__AzureOpenAI__UseManagedIdentity=false

############################################################
# Azure OpenAI (Embeddings)
############################################################

