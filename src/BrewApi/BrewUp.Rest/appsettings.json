{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BrewUp": {
    "MongoDbSettings": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "BrewUp"
    },
    "EventStore": {
      "ConnectionString": "esdb://localhost:4113?tls=false&tlsVerifyCert=false"
    },
    "RabbitMQ": {
      "Host": "localhost",
      "ExchangeCommandName": "brewup.command.exchange",
      "ExchangeEventName": "brewup.event.exchange",
      "Username": "guest",
      "Password": "guest",
      "ClientId": "BrewUp",
      "UseRMQ": true
    },
    "AzureServiceBus": {
      "ConnectionString": "your-servicebus-connectionstring",
      "TopicName": "brewup",
      "ClientId": "brewup",
      "MaxConcurrentCalls": 1,
      "UseAzureServiceBus": false
    },
    "SqlServer": {
      "ConnectionString": "your-sql-connectionstring",
      "SnapshotSize": 1000,
      "Dimensions": 1536
    },
    "Embeddings": {
      "Endpoint": "your-embedding-endpoint",
      "ApiKey": "your-embedding-api-key",
      "DeploymentName": "your-embedding-deployment",
      "Dimensions": 1536
    }
  },
  "Knowledge": {
    "VectorStore": "SqlServer"
  },
  "AzureOpenAI": {
    "Endpoint": "your-endpoint",
    "ApiKey": "your-api-key",
    "DeploymentName": "your-deployment-name"
  },
  "Mother": {
    "A2A": {
      "Enabled": false,
      "KnowledgeAgentUrl": "http://localhost:5105"
    }
  },
  "AllowedHosts": "*"
}
