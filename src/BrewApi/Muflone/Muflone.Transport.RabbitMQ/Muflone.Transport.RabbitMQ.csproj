<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Alessandro Colla - Alberto Acerbis</Authors>
    <PackageProjectUrl>https://github.com/CQRS-Muflone/Muflone.Transport.RabbitMQ</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>Broker, RabbitMQ, CQRS, Saga, Event Sourcing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>10.1.0</Version>
    <PackageReleaseNotes>Fix durability on Queues -&gt; It is important that you delete your existing active queues in RabbitMQ before updating.
Improve support to Muflone.OpenTelemetry</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Muflone" Version="10.1.0" />
    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.0" />
  </ItemGroup>

</Project>
