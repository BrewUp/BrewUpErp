<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BitBlazor" Version="0.2.3" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <BlazorWebAssemblyLazyLoad Include="BrewSpa.Dashboards.Facade.wasm" />
        <BlazorWebAssemblyLazyLoad Include="BrewSpa.MasterData.Facade.wasm" />
        <BlazorWebAssemblyLazyLoad Include="BrewSpa.Sales.Facade.wasm" />
        <BlazorWebAssemblyLazyLoad Include="BrewSpa.Chat.Facade.wasm" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BrewSpa.Shared.Components\BrewSpa.Shared.Components.csproj" />
      <ProjectReference Include="..\Chat\BrewSpa.Chat.Facade\BrewSpa.Chat.Facade.csproj" />
      <ProjectReference Include="..\Dashboards\BrewSpa.Dashboards.ApplicationServices\BrewSpa.Dashboards.ApplicationServices.csproj" />
      <ProjectReference Include="..\Dashboards\BrewSpa.Dashboards.Facade\BrewSpa.Dashboards.Facade.csproj" />
      <ProjectReference Include="..\MasterData\BrewSpa.MasterData.Facade\BrewSpa.MasterData.Facade.csproj" />
      <ProjectReference Include="..\Sales\BrewSpa.Sales.Application\BrewSpa.Sales.Application.csproj" />
      <ProjectReference Include="..\Sales\BrewSpa.Sales.Facade\BrewSpa.Sales.Facade.csproj" />
    </ItemGroup>

</Project>
