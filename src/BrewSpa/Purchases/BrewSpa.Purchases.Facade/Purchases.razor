@page "/purchases"

<PageTitle>Purchases</PageTitle>

<div class="purchases-container">
    <div class="header-section">
        <h1 class="page-title">Purchases Management</h1>
        <p class="page-subtitle">Manage purchase orders and supplier replenishments</p>
    </div>

    <div class="tiles-grid">
        <div class="tile tile-orders" @onclick="@(() => NavigateToSection("orders"))">
            <div class="tile-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 01-8 0"></path>
                </svg>
            </div>
            <h2 class="tile-title">Purchase Orders</h2>
            <p class="tile-description">Create and manage supplier purchase orders</p>
        </div>
    </div>
</div>
